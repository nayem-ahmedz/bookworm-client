# ========================
# Frontend Environment Variables (Next.js)
# ========================

# Backend API base URL (used for all API requests)
# Example: http://localhost:5000
NEXT_PUBLIC_BACKEND_API=

# ImageBB API key for image uploads
# Example: 123abc456def789ghi
NEXT_PUBLIC_imagebbAPI=

# JWT secret (used ONLY in Next.js server-side logic or middleware)
# Example: my_super_secret_jwt_key
JWT_SECRET=

# Backend base URL (server-side usage if needed)
# Example: http://localhost:5000
BACKEND_API_URL=

# Node environment
# Example: development or production
NODE_ENV=development